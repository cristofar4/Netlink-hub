// NetLink control-plane data model.
//
// Storage rules enforced by this schema:
//   * Passwords are stored only as Argon2id hashes (`User.passwordHash`).
//   * OTP codes are stored only as SHA-256 hashes (`Challenge.codeHash`).
//   * Refresh tokens are stored only as SHA-256 hashes (`RefreshToken.tokenHash`).
//   * Device private keys are never stored here at all — only `Device.publicKey`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  // Argon2id PHC string. Never a raw or reversible password.
  passwordHash  String
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  disabledAt    DateTime?

  devices        Device[]
  challenges     Challenge[]
  refreshTokens  RefreshToken[]
  auditEvents    AuditEvent[]    @relation("AuditActor")
  ownedSpaces    Space[]         @relation("SpaceOwner")
  memberships    SpaceMember[]
  createdInvites Invitation[]    @relation("InvitationCreatedBy")
  remoteSessions RemoteSession[] @relation("RemoteViewer")
  guard          AccountGuard?

  @@index([email])
  @@map("users")
}

enum DevicePlatform {
  windows
  macos
  linux
  web
  android
  ios
}

enum DeviceKind {
  desktop
  agent
  mobile
  browser
}

/// One row per NetLink installation. Every device holds its own Ed25519 key
/// pair; the private half stays on the device (Windows DPAPI), and only
/// `publicKey` reaches the server. Revoking one row never touches another.
model Device {
  id                  String         @id @default(uuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId      String
  name                String
  platform            DevicePlatform
  kind                DeviceKind     @default(desktop)
  osVersion           String?
  appVersion          String?
  // Base64url Ed25519 public key. Unique across the whole system so a key can
  // never be silently re-registered against a second account.
  publicKey           String         @unique
  trusted             Boolean        @default(false)
  trustedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  // Coarse, city-level at best. Derived from the request IP, never GPS.
  approximateLocation String?
  lastIpAddress       String?

  refreshTokens RefreshToken[]
  challenges    Challenge[]
  agent         Agent?

  @@unique([userId, installationId])
  @@index([userId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Verification challenges (six-digit email codes)
// ---------------------------------------------------------------------------

enum ChallengePurpose {
  email_verification
  device_verification
  step_up
}

/// A pending six-digit code. The code itself is never stored — only a SHA-256
/// hash of it, so a database read cannot reveal a live code.
model Challenge {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            Device?          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  purpose           ChallengePurpose
  codeHash          String
  expiresAt         DateTime
  // Set the moment a code is accepted, which makes the code single-use.
  consumedAt        DateTime?
  attempts          Int              @default(0)
  maxAttempts       Int              @default(5)
  resendCount       Int              @default(0)
  lastSentAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  // Carried through device verification so "Trust This Device" survives the
  // round trip without the client being able to alter the pending device.
  pendingDeviceName String?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("challenges")
}

// ---------------------------------------------------------------------------
// Sessions
// ---------------------------------------------------------------------------

/// Rotating refresh tokens. Each use issues a successor and marks the parent
/// rotated; presenting an already-rotated token is treated as theft and kills
/// the whole chain.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  // Every token in one login lineage shares a family id, so a detected reuse
  // can revoke exactly that lineage and nothing else.
  familyId      String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?   @unique

  @@index([userId, deviceId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Spaces, agents and membership
// ---------------------------------------------------------------------------

/// A location: My Home, My Office, My Shop.
model Space {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          SpaceMember[]
  agents           Agent[]
  invitations      Invitation[]
  auditEvents      AuditEvent[]
  resources        Resource[]
  enrollmentTokens AgentEnrollmentToken[]
  dataPool         DataPool?
  powerCommands    PowerCommand[]
  fileTransfers    FileTransfer[]
  printJobs        PrintJob[]
  remoteSessions   RemoteSession[]

  @@index([ownerId])
  @@map("spaces")
}

enum PrincipalRole {
  owner
  trusted_device
  invited_member
}

/// Grants held by a person inside a Space. `permissions` is the complete,
/// explicit capability list — an empty array means the member can do nothing.
model SpaceMember {
  id          String        @id @default(uuid())
  spaceId     String
  space       Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        PrincipalRole
  permissions String[]      @default([])
  suspended   Boolean       @default(false)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  allocation DataAllocation?

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@map("space_members")
}

enum AgentStatus {
  offline
  online
  unreachable
}

/// The background service half of a NetLink installation. Registered in
/// Phase 2; the row exists now so device enrollment has somewhere to point.
model Agent {
  id              String      @id @default(uuid())
  spaceId         String
  space           Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  deviceId        String      @unique
  device          Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status          AgentStatus @default(offline)
  lastHeartbeatAt DateTime?
  // Registered out-of-band by the owner, used for Wake-on-LAN targeting.
  macAddress      String?
  localIpAddress  String?
  isWakeHelper    Boolean     @default(false)
  wakeOnLanReady  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  resources             Resource[]
  powerCommandsAsTarget PowerCommand[]  @relation("PowerTarget")
  powerCommandsAsHelper PowerCommand[]  @relation("PowerHelper")
  remoteSessions        RemoteSession[]

  @@index([spaceId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Invitations (NetLink Passes)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  pending
  claimed
  revoked
  expired
}

/// A NetLink Pass. The claim token is stored hashed and can be redeemed once.
model Invitation {
  id              String           @id @default(uuid())
  spaceId         String
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User             @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  inviteeEmail    String?
  tokenHash       String           @unique
  permissions     String[]         @default([])
  status          InvitationStatus @default(pending)
  allowResharing  Boolean          @default(false)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  // Data-Only pass terms. Null for passes that are not data allocations.
  totalDataBytes Decimal? @db.Decimal(20, 0)
  dailyDataBytes Decimal? @db.Decimal(20, 0)

  @@index([spaceId, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditOutcome {
  success
  failure
  denied
}

/// Append-only record of security-relevant activity. Carries no file contents,
/// message text, credentials or precise location — only what happened.
model AuditEvent {
  id                  String       @id @default(uuid())
  action              String
  outcome             AuditOutcome
  actorUserId         String?
  actorUser           User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorDeviceId       String?
  targetDeviceId      String?
  spaceId             String?
  space               Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  ipAddress           String?
  userAgent           String?
  approximateLocation String?
  metadata            Json?
  createdAt           DateTime     @default(now())

  @@index([actorUserId, createdAt])
  @@index([spaceId, createdAt])
  @@index([action])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Phase 2 — agent enrollment and resources
// ---------------------------------------------------------------------------

/// A short-lived token the desktop app hands to the local agent so the service
/// can enroll itself without ever seeing the owner's password.
model AgentEnrollmentToken {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([spaceId])
  @@map("agent_enrollment_tokens")
}

/// Replay guard for signed agent requests.
///
/// The agent's own nonce store is in memory; this is the server half, and it
/// survives a restart. Rows are swept once they pass `expiresAt`.
model RequestNonce {
  nonce     String   @id
  scope     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("request_nonces")
}

enum ResourceKind {
  folder
  printer
}

/// Something an agent offers to the Space: an approved folder, a shared
/// printer. Nothing is exposed until the owner adds it here.
model Resource {
  id        String       @id @default(uuid())
  spaceId   String
  space     Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind      ResourceKind
  name      String
  /// For a folder, the approved root path. For a printer, its Windows name.
  target    String
  enabled   Boolean      @default(true)
  /// Free-form, agent-reported detail (printer status, drive free space).
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transfers FileTransfer[]
  printJobs PrintJob[]

  @@unique([agentId, kind, target])
  @@index([spaceId, kind])
  @@map("resources")
}

// ---------------------------------------------------------------------------
// Phase 3 — Data Pool
// ---------------------------------------------------------------------------

/// The Space's link to a telecom, ISP or MVNO account.
///
/// `provider` names the adapter. `demo` is the development fixture and is
/// labelled as such everywhere it surfaces; a real provider is added by
/// implementing the same adapter interface, not by changing this model.
model DataPool {
  id         String   @id @default(uuid())
  spaceId    String   @unique
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  provider   String   @default("demo")
  /// The account identifier at the provider (a mobile number, a subscriber id).
  accountRef String
  /// Whatever the adapter needs to describe the plan. Never a credential.
  planName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  allocations DataAllocation[]

  @@map("data_pools")
}

enum AllocationStatus {
  active
  paused
  expired
  revoked
}

/// One person's share of the pool.
///
/// Byte counts are Decimal(20,0) rather than BigInt so a terabyte allocation
/// and its usage arithmetic stay exact — a float would silently lose precision
/// at exactly the scale that matters for billing.
model DataAllocation {
  id       String           @id @default(uuid())
  poolId   String
  pool     DataPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  spaceId  String
  memberId String           @unique
  member   SpaceMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status   AllocationStatus @default(active)

  totalBytes     Decimal   @db.Decimal(20, 0)
  dailyBytes     Decimal?  @db.Decimal(20, 0)
  usedBytes      Decimal   @default(0) @db.Decimal(20, 0)
  usedTodayBytes Decimal   @default(0) @db.Decimal(20, 0)
  /// The day `usedTodayBytes` counts, so the daily figure resets on its own
  /// rather than needing a scheduled job.
  usageDay       DateTime?

  expiresAt      DateTime
  /// Whether the holder may pass their allocation on. Off by default.
  allowResharing Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pausedAt  DateTime?
  revokedAt DateTime?

  events DataUsageEvent[]

  @@index([spaceId, status])
  @@map("data_allocations")
}

/// A metered chunk of usage, as reported by the provider.
///
/// Records quantity, session time and which device — never a destination, a
/// hostname or anything resembling browsing history.
model DataUsageEvent {
  id             String         @id @default(uuid())
  allocationId   String
  allocation     DataAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  bytes          Decimal        @db.Decimal(20, 0)
  sessionSeconds Int            @default(0)
  deviceId       String?
  /// Provider's own id for this record, so a replayed webhook is idempotent.
  providerRef    String?        @unique
  occurredAt     DateTime
  createdAt      DateTime       @default(now())

  @@index([allocationId, occurredAt])
  @@map("data_usage_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — power commands
// ---------------------------------------------------------------------------

enum PowerCommandState {
  pending
  countdown
  sent
  acknowledged
  succeeded
  failed
  cancelled
  expired
}

/// One signed power command.
///
/// The signature itself is not stored — it is derived from the signing key on
/// delivery, so a database read cannot yield a usable command. What is stored
/// is the record of what was asked for, by whom, and what happened.
model PowerCommand {
  id            String  @id @default(uuid())
  spaceId       String
  space         Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The computer the command is for.
  targetAgentId String
  targetAgent   Agent   @relation("PowerTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)
  /// For a wake, the computer asked to send the magic packet. Null otherwise.
  helperAgentId String?
  helperAgent   Agent?  @relation("PowerHelper", fields: [helperAgentId], references: [id], onDelete: SetNull)

  action              String
  state               PowerCommandState @default(pending)
  requestedById       String
  requestedByDeviceId String?

  nonce     String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  /// When the ten-second countdown ends and the command may actually be sent.
  executeAt DateTime?

  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  detail         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetAgentId, state])
  @@index([spaceId, createdAt])
  @@map("power_commands")
}

// ---------------------------------------------------------------------------
// Phase 5 — files and printers
// ---------------------------------------------------------------------------

enum TransferDirection {
  download
  upload
}

enum TransferState {
  pending
  active
  completed
  failed
  cancelled
}

/// A brokered file transfer.
///
/// This records that a transfer was authorised and what became of it. The bytes
/// never touch this database or this server — they move directly between the
/// owner's devices, which is why a control-plane compromise cannot leak files.
model FileTransfer {
  id               String            @id @default(uuid())
  spaceId          String
  space            Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  resourceId       String
  resource         Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  agentId          String
  requestedById    String
  direction        TransferDirection
  /// Relative to the approved folder. Recorded so an owner can see what moved.
  path             String
  state            TransferState     @default(pending)
  sizeBytes        Decimal?          @db.Decimal(20, 0)
  transferredBytes Decimal           @default(0) @db.Decimal(20, 0)
  checksum         String?
  detail           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completedAt      DateTime?

  @@index([spaceId, createdAt])
  @@index([agentId, state])
  @@map("file_transfers")
}

enum PrintJobState {
  queued
  sent
  printing
  completed
  failed
}

/// A print job.
///
/// The document is held only until the agent collects it, then dropped. A
/// printed page is content, and the control plane does not keep content.
model PrintJob {
  id            String        @id @default(uuid())
  spaceId       String
  space         Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  agentId       String
  requestedById String
  printerName   String
  documentName  String
  /// The PDF, base64, cleared the moment the agent takes it.
  document      String?
  copies        Int           @default(1)
  colour        Boolean       @default(true)
  paperSize     String        @default("A4")
  state         PrintJobState @default(queued)
  detail        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  collectedAt   DateTime?
  completedAt   DateTime?

  @@index([agentId, state])
  @@index([spaceId, createdAt])
  @@map("print_jobs")
}

// ---------------------------------------------------------------------------
// Phase 6 — remote desktop
// ---------------------------------------------------------------------------

enum RemoteSessionMode {
  view
  control
}

enum RemoteSessionState {
  pending
  connecting
  active
  ended
}

/// A remote desktop session.
///
/// This row is the whole of what the control plane knows: who connected to
/// which computer, in which mode, for how long, and whether the media went
/// direct or through a relay. The pixels and the keystrokes never come near it.
///
/// `mode` is authoritative and immutable once written — it is copied into a
/// signed grant that the agent verifies, which is what makes "view only" a
/// boundary rather than a label on a button.
model RemoteSession {
  id             String  @id @default(uuid())
  spaceId        String
  space          Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  viewerId       String
  viewer         User    @relation("RemoteViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  /// The viewer's device, so revoking that device can end the session.
  viewerDeviceId String?

  mode  RemoteSessionMode
  state RemoteSessionState @default(pending)

  /// Single-use, inside the signed grant. Stops a captured grant being reused.
  nonce     String   @unique
  issuedAt  DateTime @default(now())
  /// When the grant stops being usable to open a connection.
  expiresAt DateTime

  connectedAt   DateTime?
  endedAt       DateTime?
  endReason     String?
  /// direct, relayed or unknown, derived from the candidate pair in use.
  strategy      String    @default("unknown")
  /// Reset by viewer heartbeats and by input; drives the idle timeout.
  lastSeenAt    DateTime  @default(now())
  /// How many input events the host refused because the session was view-only.
  refusedInputs Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals RemoteSignal[]

  @@index([agentId, state])
  @@index([spaceId, createdAt])
  @@index([viewerId, state])
  @@map("remote_sessions")
}

enum SignalRole {
  viewer
  host
}

/// One signalling message, on its way between the two peers.
///
/// Offers, answers and ICE candidates only — bounded in size, ordered by `seq`,
/// and deleted with the session. This is a post box, not a channel: neither
/// side can use it to move anything the other could not already send directly.
model RemoteSignal {
  id          String        @id @default(uuid())
  sessionId   String
  session     RemoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq         Int
  from        SignalRole
  kind        String
  payload     String
  createdAt   DateTime      @default(now())
  /// Set once the other side has read it, so a poll never re-delivers.
  deliveredAt DateTime?

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@map("remote_signals")
}

// ---------------------------------------------------------------------------
// Phase 7 — production hardening
// ---------------------------------------------------------------------------

/// One rate-limit counter, shared across every API instance.
///
/// Here rather than in Redis on purpose: the database is already a hard
/// dependency, already secured and already backed up, and a single
/// `INSERT … ON CONFLICT DO UPDATE` gives the only property that matters —
/// an increment no two instances can interleave.
model RateLimitBucket {
  key       String   @id
  count     Int
  /// When the window ends. Rows past it are reset in place, and swept in bulk.
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// A record of repeated authentication failures against one account.
///
/// Separate from the per-IP limiter because the two stop different attacks.
/// Per-IP throttling stops one machine trying many passwords; this stops many
/// machines trying passwords against one account, which is what credential
/// stuffing actually looks like and what per-IP limits cannot see.
///
/// Deliberately not a permanent lockout: that would hand anyone who knows an
/// email address the ability to lock its owner out. The delay grows and then
/// decays on its own.
model AccountGuard {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failures     Int       @default(0)
  firstFailure DateTime  @default(now())
  lastFailure  DateTime  @default(now())
  /// Set while the account is cooling off. Null means it is not.
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("account_guards")
}
