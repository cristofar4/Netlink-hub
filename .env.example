# ---------------------------------------------------------------------------
# NetLink environment
#
# Copy to .env and fill in. `scripts/setup-windows.ps1` does this for you and
# generates the secrets, so you normally do not edit this by hand.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Control plane (apps/api) ----------------------------------------------
PORT=4000
HOST=127.0.0.1
API_PREFIX=api

# PostgreSQL. docker-compose.yml brings up a matching instance on 5432.
DATABASE_URL=postgresql://netlink:netlink@localhost:5432/netlink?schema=public

# Signing key for short-lived access tokens.
# Generate with: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=netlink
JWT_AUDIENCE=netlink-client

REFRESH_TOKEN_TTL_DAYS=30
# A device the owner did not choose to trust gets a much shorter session.
UNTRUSTED_REFRESH_TOKEN_TTL_DAYS=1

# --- Email -----------------------------------------------------------------
# console = print the message (and the code) to the API log — development only
# smtp    = real delivery
# memory  = in-process, used by tests
MAIL_TRANSPORT=console
MAIL_FROM="NetLink <no-reply@netlink.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Returns the six-digit code in the API response so you can complete the flow
# without a mailbox. The API refuses to start with this enabled in production.
EXPOSE_DEV_OTP=true

# --- Client ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://wails.localhost
ENABLE_OPENAPI=true

# --- Remote desktop (ICE) --------------------------------------------------
# STUN only tells a peer its own public address; it carries no media and sees
# no traffic. Leave it empty and remote desktop works only between machines
# that can already reach each other — which is fine on one home network and
# not much use anywhere else. Prefer running your own; a public server means
# handing a third party the times you connect and from where.
STUN_URLS=

# TURN relays media when the two networks will not allow a direct path, which
# is the common case behind mobile or carrier-grade NAT. The secret is the one
# coturn is started with (`static-auth-secret`) — never a password given to a
# client. Credentials are minted per session and expire in minutes.
#   turnserver --use-auth-secret --static-auth-secret <the same value>
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=300

# --- Rate limits -----------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=10

# --- Desktop app (apps/desktop) --------------------------------------------
VITE_NETLINK_API_URL=http://127.0.0.1:4000/api

# --- Local agent (services/agent) ------------------------------------------
NETLINK_API_URL=http://127.0.0.1:4000/api
NETLINK_HEARTBEAT_SECONDS=30

# --- PostgreSQL container (docker-compose.yml) -----------------------------
POSTGRES_USER=netlink
POSTGRES_PASSWORD=netlink
POSTGRES_DB=netlink
POSTGRES_PORT=5432
